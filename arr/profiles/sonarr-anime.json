{
  "custom_formats": [
    {
      "name": "FRENCH",
      "specifications": [
        {
          "name": "FRENCH",
          "implementation": "ReleaseTitleSpecification",
          "negate": false,
          "required": true,
          "value": "\\b(TRUEFRENCH|FRENCH|VFF|VFQ)\\b(?![^()]*\\))(?<!\\([^)]*)"
        }
      ]
    },
    {
      "name": "VOSTFR (hors suffixe)",
      "specifications": [
        {
          "name": "VOSTFR",
          "implementation": "ReleaseTitleSpecification",
          "negate": false,
          "required": false,
          "value": "\\b(VOST.*?FR(E|A)?)\\b(?![^()]*\\))(?<!\\([^)]*)"
        },
        {
          "name": "SUBFRENCH",
          "implementation": "ReleaseTitleSpecification",
          "negate": false,
          "required": false,
          "value": "\\b(SUBFR(A|ENCH)?)\\b(?![^()]*\\))(?<!\\([^)]*)"
        }
      ]
    },
    {
      "name": "Pack NN of NN",
      "specifications": [
        {
          "name": "NN of NN",
          "implementation": "ReleaseTitleSpecification",
          "negate": false,
          "required": true,
          "value": "\\[\\s*\\d{1,3}\\s+(of|из)\\s+\\d{1,3}\\s*\\]"
        }
      ]
    },
    {
      "name": "Subs non-FR (JSub/ESub)",
      "specifications": [
        {
          "name": "Marqueur de sous-titres",
          "implementation": "ReleaseTitleSpecification",
          "negate": false,
          "required": true,
          "value": "\\b(?:Japanese|English)[-\\s]Subs?\\b|\\b[EJ]-?Subs?\\b"
        },
        {
          "name": "Aucun marqueur FR",
          "implementation": "ReleaseTitleSpecification",
          "negate": true,
          "required": true,
          "value": "\\b(?:MULTi|Multi-Subs?|Multi-Audio|VOST.*?FR(?:E|A)?|SUBFR(?:A|ENCH)?|TRUEFRENCH|FRENCH|VFF|VFQ|VF)\\b"
        }
      ]
    }
  ],
