# local tooling config (machine/session-specific)
.claude/settings.local.json
server.geany

# Python bytecode cache (scripts/torrent-cleanup.py)
__pycache__/
*.pyc

# secrets / deployment-identifying values
.env
**/.env
.env.shared

# host-specific bind mounts (folder layout only makes sense on this
# deployment) — see */docker-compose.override.yml.example
**/docker-compose.override.yml

# runtime data / state (not infra-as-code)
traefik/letsencrypt/

# generated dashboard page (embeds DOMAIN + real hostnames) — regenerated by
# `make dashboard-refresh`, see scripts/generate-dashboard.py
dashboard/html/
dashboard/refresh.log

# cron job output logs (host-specific, not infra-as-code)
arr/apply-overrides.log
arr/recyclarr-sync.log

# VPN client credentials (private key + certs, not infra-as-code)
vpn/custom/

# restic backup repository + staging data (large/binary, not infra-as-code —
# see scripts/backup.sh; the repo password lives here too, never commit it)
sauvegarde/
