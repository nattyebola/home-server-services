# local tooling config (machine/session-specific)
.claude/settings.local.json

# secrets / deployment-identifying values
.env
**/.env
.env.shared

# host-specific bind mounts (folder layout only makes sense on this
# deployment) — see */docker-compose.override.yml.example
**/docker-compose.override.yml

# runtime data / state (not infra-as-code)
traefik/letsencrypt/

# VPN client credentials (private key + certs, not infra-as-code)
vpn/custom/

# restic backup repository + staging data (large/binary, not infra-as-code —
# see scripts/backup.sh; the repo password lives here too, never commit it)
sauvegarde/
