# Installed via `make cron-install` (see Makefile) — this file is the
# source of truth for this host's crontab. Editing the live crontab
# directly (crontab -e) will silently be overwritten on the next install;
# edit this file and re-run the target instead.
MAILTO=""

# Nextcloud background jobs, every 5 minutes (occ background:cron via cron.php)
# the placeholder below is substituted by `make cron-install` with PUID from
# .env.shared — never hardcode a literal uid here.
*/5 * * * * docker exec -u __PUID__ nextcloud-app-1 php -f /var/www/html/cron.php

# Weekly restic backup (Nextcloud DB dump + data + .env secrets + image
# digest manifest) — see scripts/backup.sh
# the placeholder below is substituted by `make cron-install` with this
# checkout's absolute path — never hardcode a literal path here.
0 3 * * 0 __REPO_ROOT__/scripts/backup.sh >> __REPO_ROOT__/sauvegarde/backup.log 2>&1

# Refresh the dashboard every 5 minutes — mainly to reflect healthcheck
# status (see CLAUDE.md) without waiting on a manual `make dashboard-refresh`.
*/5 * * * * python3 __REPO_ROOT__/scripts/generate-dashboard.py >> __REPO_ROOT__/dashboard/refresh.log 2>&1

# Trigger recyclarr sync (manual mode, no internal scheduler — see
# arr/docker-compose.yml) then immediately reapply the Sonarr/Radarr
# quality-definition size overrides + Radarr language field that it just
# reset to guide defaults (see arr/recyclarr/recyclarr.yml and
# scripts/apply-arr-overrides.py). Chained in one crontab line rather than
# two separate schedules so the window where these settings are wrong is
# bounded by the sync's actual duration, not an estimated safety delay.
0 0 * * * make -C __REPO_ROOT__ recyclarr-sync >> __REPO_ROOT__/arr/recyclarr-sync.log 2>&1 && python3 __REPO_ROOT__/scripts/apply-arr-overrides.py >> __REPO_ROOT__/arr/apply-overrides.log 2>&1
