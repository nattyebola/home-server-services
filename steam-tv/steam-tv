#!/usr/bin/env bash
# Steam Big Picture seul sur une console virtuelle, sous gamescope (HDR, VRR, manettes).
# Lancé automatiquement sur tty3 par ~/.zprofile (autologin getty@tty3), voir steam-tv/README.md.
# Relancer à la main : steam-tv
set -u

if [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]]; then
  echo "steam-tv se lance depuis une console virtuelle (Ctrl+Alt+F3), pas depuis GNOME." >&2
  exit 1
fi

# Depuis la mise à jour de Steam du 2026-11-13, chaque jeu tourne dans son propre scope
# (app-steam-app<id>-<pid>.scope), hors de steam-tv.scope : il faut le geler aussi.
# Un seul Steam par utilisateur (voir plus bas) : tous ces scopes sont les siens.
game_scopes() {
  systemctl --user list-units --type=scope --state=active --plain --no-legend \
    'app-steam-app*.scope' | awk '{print $1}'
}

# Un Steam resté gelé (session précédente interrompue) ne répondrait pas à -shutdown
systemctl --user thaw steam-tv.scope $(game_scopes) 2>/dev/null

# Un utilisateur = une seule instance de Steam : celle de GNOME doit être fermée d'abord.
if pgrep -u "$USER" -x steam >/dev/null; then
  echo "Steam tourne déjà (session GNOME ?)."
  read -r -p "Entrée = le fermer proprement et basculer ici, Ctrl+C = annuler. " _
  /usr/games/steam -shutdown >/dev/null 2>&1
  for _ in {1..30}; do
    pgrep -u "$USER" -x steam >/dev/null || break
    sleep 1
  done
  if pgrep -u "$USER" -x steam >/dev/null; then
    echo "Steam ne s'est pas fermé en 30 s : ferme-le depuis GNOME, puis relance steam-tv." >&2
    exit 1
  fi
fi

log_dir=${XDG_STATE_HOME:-$HOME/.local/state}
mkdir -p "$log_dir"
echo "Steam Big Picture démarre (journal : $log_dir/steam-tv.log)…"

# gamescope ne lit pas la disposition de GNOME : XKB par défaut = qwerty US
export XKB_DEFAULT_LAYOUT=fr XKB_DEFAULT_VARIANT=latin9

# HDR pour tous les jeux Proton (DXVK et vkd3d-proton) : sans ça, l'option HDR du jeu
# reste grisée, gamescope ne le pose pas lui-même. Par jeu : DXVK_HDR=0 %command%
export DXVK_HDR=1

# FSR 3.1 → FSR 4 (RX 9070 = RDNA4) : lu par GE-Proton seulement, ignoré par les Proton
# de Valve. Par jeu : PROTON_FSR4_UPGRADE=0 %command%
export PROTON_FSR4_UPGRADE=1

# gamescope, Steam, un éventuel jeu et le presse-papiers vivent dans un scope systemd
# qu'on gèle d'un bloc (cgroup freezer) quand la console n'est plus affichée : sinon
# l'interface de Steam continue de dessiner en arrière-plan (~25-30 W de GPU mesurés).
scope=steam-tv.scope
systemctl --user stop "$scope" 2>/dev/null   # reste d'une session précédente
vt_dev=$(tty)            # /dev/tty3
vt_num=${vt_dev#/dev/tty}
settle=2                 # s entre la bascule et le gel, voir pause_when_hidden

vt_shown() { [[ $(</sys/class/tty/tty0/active) == "tty$vt_num" ]]; }

# Bloque jusqu'au départ de la console. Le noyau signale chaque bascule sur
# /sys/class/tty/tty0/active (sysfs_notify, ce que surveille logind) : poll() en
# POLLPRI rend la main aussitôt. Le timeout de 60 s n'est qu'un filet de sécurité.
# Repli : sondage à la seconde.
wait_vt_hidden() {
  python3 -c 'import select, sys
f = open("/sys/class/tty/tty0/active")
p = select.poll()
p.register(f, select.POLLPRI | select.POLLERR)
while True:
    f.seek(0)
    if f.read().strip() != sys.argv[1]:
        break
    p.poll(60000)' "tty$vt_num" 2>/dev/null && return
  while vt_shown; do sleep 1; done
}

# Attend le retour sur la console, $1 secondes au plus ; vrai si elle est revenue.
# VT_WAITACTIVE (0x5607) rend la main dès la bascule, sans sondage.
wait_vt_shown() {
  timeout "$1" python3 -c 'import fcntl, os, sys
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOCTTY)
fcntl.ioctl(fd, 0x5607, int(sys.argv[2]))' "$vt_dev" "$vt_num" 2>/dev/null
  vt_shown
}

# Icône Steam dans la barre de GNOME : un clic interroge Steam par D-Bus (menu, activation),
# sans réponse tant qu'il est gelé. tray_watch dégèle Steam et ses jeux dès qu'un tel appel
# lui est destiné ; pause_when_hidden les regèle après $tray_idle s sans nouveau clic.
tray_idle=5
tray_mark=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/steam-tv.tray
tray_watch() {
  dbus-monitor --session "type='method_call',interface='com.canonical.dbusmenu'" \
    "type='method_call',interface='org.kde.StatusNotifierItem'" 2>/dev/null |
  while read -r line; do
    [[ $line == "method call "* && $line =~ destination=([^ ]+) ]] || continue
    vt_shown && continue
    # Seulement si le destinataire est dans notre scope (pas l'icône d'une autre appli)
    pid=$(busctl --user status "${BASH_REMATCH[1]}" 2>/dev/null | sed -n 's/^PID=//p')
    grep -q "/$scope\$" "/proc/$pid/cgroup" 2>/dev/null || continue
    touch "$tray_mark"
    systemctl --user thaw "$scope" $(game_scopes)
  done
}

# Hors du scope, sinon elle se gèlerait elle-même
pause_when_hidden() {
  while true; do
    wait_vt_hidden
    # Laisse gamescope rendre l'écran (« Session paused ») avant de le figer ; un
    # aller-retour rapide entre consoles ne gèle rien.
    sleep "$settle"
    vt_shown && continue
    frozen=("$scope" $(game_scopes))
    systemctl --user freeze "${frozen[@]}" || { sleep 5; continue; }
    until wait_vt_shown 1; do
      # Dégelé par un clic sur l'icône : regel après $tray_idle s sans nouveau clic
      [[ $(systemctl --user show -p FreezerState --value "$scope") == running ]] || continue
      (( $(date +%s) - $(stat -c %Y "$tray_mark" 2>/dev/null || echo 0) > tray_idle )) || continue
      frozen=("$scope" $(game_scopes))
      systemctl --user freeze "${frozen[@]}"
    done
    systemctl --user thaw "${frozen[@]}"
  done
}
pause_when_hidden &
watch_pid=$!
tray_watch &
tray_pid=$!
# À la sortie de gamescope : arrêter les surveillances (et le dbus-monitor de tray_watch)
# et ce qui resterait du scope (presse-papiers)
trap 'pkill -P $tray_pid 2>/dev/null; kill $watch_pid $tray_pid 2>/dev/null
      systemctl --user stop "$scope" 2>/dev/null' EXIT

here=$(dirname "$(readlink -f "$0")")
clipboard=$here/steam-tv-clipboard
fps=$here/steam-tv-fps   # coin / masquer du menu Performances → mangoapp

# Overlay de performances de Big Picture (compteur d'IPS, menu Performances) : gamescope
# lance mangoapp (compilé par build-mangoapp.sh) et annonce à Steam qu'il est là.
# Sous gamescope -e, Steam n'injecte pas son overlay classique : sans mangoapp, pas d'IPS.
mangoapp=()
export PATH="$HOME/.local/bin:$PATH"
if command -v mangoapp >/dev/null; then
  mangoapp=(--mangoapp)
  # read_cfg : le fichier MANGOHUD_CONFIGFILE (coin, masquer, écrits par steam-tv-fps)
  # reste lu, ce qui suit s'applique par-dessus. IPS seuls, en gros (24 px par défaut,
  # minuscule en 4K).
  export MANGOHUD_CONFIG=read_cfg,fps_only,font_size=48
else
  echo "mangoapp absent : pas de compteur d'IPS (make steam-tv-install)." >&2
fi

# -e : intégration Steam (overlay, réglages d'affichage et HDR pilotés depuis Big Picture)
# -W/-H : sortie 4K de la TV ; fréquence = mode préféré de l'écran
# Presse-papiers et pont IPS dans le scope : gelés avec gamescope, ils ne bloquent pas sur un Xwayland figé.
systemd-run --user --scope --quiet --collect --unit="$scope" -- \
  bash -c '"$1" & "$2" & exec "${@:3}"' _ "$clipboard" "$fps" \
  gamescope -e -f --hdr-enabled --adaptive-sync -W 3840 -H 2160 "${mangoapp[@]}" \
  -- /usr/games/steam -gamepadui >"$log_dir/steam-tv.log" 2>&1
status=$?

echo "gamescope s'est arrêté (code $status). Relancer : steam-tv — retour à GNOME : Ctrl+Alt+F2."
