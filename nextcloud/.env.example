POSTGRES_USER=
POSTGRES_PASSWORD=
# Compte admin créé par l'image Nextcloud à la PREMIÈRE installation seulement
# (une instance déjà installée les ignore). Le service news-updater ne s'en
# sert plus : il a son propre mot de passe d'application, voir
# news-updater/config.ini.example.
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=
